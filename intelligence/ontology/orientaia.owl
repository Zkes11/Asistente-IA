<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:or="http://orientaia.local/ontology#">
  <owl:Ontology rdf:about="http://orientaia.local/ontology">
    <rdfs:label xml:lang="es">Ontologia OrientaIA</rdfs:label>
  </owl:Ontology>

  <owl:Class rdf:about="http://orientaia.local/ontology#Student"/>
  <owl:Class rdf:about="http://orientaia.local/ontology#Interest"/>
  <owl:Class rdf:about="http://orientaia.local/ontology#Skill"/>
  <owl:Class rdf:about="http://orientaia.local/ontology#Preference"/>
  <owl:Class rdf:about="http://orientaia.local/ontology#AcademicArea"/>
  <owl:Class rdf:about="http://orientaia.local/ontology#AcademicProgram"/>
  <owl:Class rdf:about="http://orientaia.local/ontology#University"/>
  <owl:Class rdf:about="http://orientaia.local/ontology#Recommendation"/>
  <owl:Class rdf:about="http://orientaia.local/ontology#Assessment"/>
  <owl:Class rdf:about="http://orientaia.local/ontology#ActionPlan"/>

  <owl:ObjectProperty rdf:about="http://orientaia.local/ontology#hasInterest">
    <rdfs:domain rdf:resource="http://orientaia.local/ontology#Student"/>
    <rdfs:range rdf:resource="http://orientaia.local/ontology#Interest"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://orientaia.local/ontology#hasSkill">
    <rdfs:domain rdf:resource="http://orientaia.local/ontology#Student"/>
    <rdfs:range rdf:resource="http://orientaia.local/ontology#Skill"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://orientaia.local/ontology#hasPreference">
    <rdfs:domain rdf:resource="http://orientaia.local/ontology#Student"/>
    <rdfs:range rdf:resource="http://orientaia.local/ontology#Preference"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://orientaia.local/ontology#requiresSkill">
    <rdfs:domain rdf:resource="http://orientaia.local/ontology#AcademicProgram"/>
    <rdfs:range rdf:resource="http://orientaia.local/ontology#Skill"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://orientaia.local/ontology#relatesToInterest">
    <rdfs:domain rdf:resource="http://orientaia.local/ontology#AcademicProgram"/>
    <rdfs:range rdf:resource="http://orientaia.local/ontology#Interest"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://orientaia.local/ontology#belongsToArea">
    <rdfs:domain rdf:resource="http://orientaia.local/ontology#AcademicProgram"/>
    <rdfs:range rdf:resource="http://orientaia.local/ontology#AcademicArea"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://orientaia.local/ontology#offersProgram">
    <rdfs:domain rdf:resource="http://orientaia.local/ontology#University"/>
    <rdfs:range rdf:resource="http://orientaia.local/ontology#AcademicProgram"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://orientaia.local/ontology#recommendsProgram">
    <rdfs:domain rdf:resource="http://orientaia.local/ontology#Recommendation"/>
    <rdfs:range rdf:resource="http://orientaia.local/ontology#AcademicProgram"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://orientaia.local/ontology#generatedFromAssessment">
    <rdfs:domain rdf:resource="http://orientaia.local/ontology#Recommendation"/>
    <rdfs:range rdf:resource="http://orientaia.local/ontology#Assessment"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://orientaia.local/ontology#hasActionPlan">
    <rdfs:domain rdf:resource="http://orientaia.local/ontology#Student"/>
    <rdfs:range rdf:resource="http://orientaia.local/ontology#ActionPlan"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://orientaia.local/ontology#label"/>
  <owl:DatatypeProperty rdf:about="http://orientaia.local/ontology#description"/>
  <owl:DatatypeProperty rdf:about="http://orientaia.local/ontology#compatibilityScore"/>
  <owl:DatatypeProperty rdf:about="http://orientaia.local/ontology#confidenceLevel"/>
  <owl:DatatypeProperty rdf:about="http://orientaia.local/ontology#source"/>
  <owl:DatatypeProperty rdf:about="http://orientaia.local/ontology#updatedAt"/>

  <or:Student rdf:about="http://orientaia.local/ontology#DemoStudent">
    <or:label>Estudiante demo</or:label>
  </or:Student>
  <or:AcademicProgram rdf:about="http://orientaia.local/ontology#DemoProgram">
    <or:label>Ingenieria de Sistemas</or:label>
  </or:AcademicProgram>
</rdf:RDF>
